---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="brand">
			<a href="/">
				<img src="/logo.png" alt="LuVicen" class="logo" />
				<span>{SITE_TITLE}</span>
			</a>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">Acerca</HeaderLink>
		</div>
		<div class="contact-links">
			<a href="mailto:admin@luvicen.cl">admin@luvicen.cl</a>
			<a href="https://wa.me/56984117366">WhatsApp</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.brand a {
		display: flex;
		align-items: center;
		text-decoration: none;
		color: var(--black);
	}
	.logo {
		height: 38px;
		width: auto;
		border-radius: 8px;
		object-fit: contain;
	}
	.internal-links {
		display: flex;
		gap: 1rem;
	}
	.contact-links {
		display: flex;
		gap: 1rem;
		align-items: center;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		.contact-links {
			flex-direction: column;
			align-items: flex-start;
		}
		.internal-links {
			width: 100%;
			justify-content: space-evenly;
			margin-top: 0.5rem;
		}
	}
</style>
