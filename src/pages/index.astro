---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-copy">
					<h1>LuVicen</h1>
					<p>Apps Android básicas, personalizadas y funcionales para emprendedores, streamers y pymes.</p>
					<p class="hero-subtitle">
						Soluciones de bajo costo, con bajo consumo de recursos y 100% enfocadas en tu idea.
					</p>
					<div class="hero-actions">
						<a class="button" href="mailto:admin@luvicen.cl">Escríbenos</a>
						<a class="button button-secondary" href="https://www.luvicen.cl">Visitaos en Play Store</a>
					</div>
				</div>
				<div class="hero-image">
					<img src="/logo.png" alt="Logo LuVicen" />
				</div>
			</section>

			<section class="services">
				<h2>Qué ofrecemos</h2>
				<ul>
					<li>Apps Android personalizadas para servicios y ventas.</li>
					<li>Diseño simple, rápido y optimizado para móviles.</li>
					<li>Bajo consumo de batería y datos.</li>
					<li>Soluciones accesibles para emprendedores y pequeñas empresas.</li>
				</ul>
			</section>

			<section class="contact-card">
				<h2>Contacto</h2>
				<p>Web: <a href="https://www.luvicen.cl">www.luvicen.cl</a></p>
				<p>Email: <a href="mailto:admin@luvicen.cl">admin@luvicen.cl</a></p>
				<p>WhatsApp: <a href="https://wa.me/56984117366">+56 9 8411 7366</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
